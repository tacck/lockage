{
  "name": "lockage",
  "version": "0.9.7",
  "description": "Lockage — an MCP server for multiple coding LLMs to collaborate around a local git repository (single host)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tacck/lockage.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "bin": {
    "lockage": "dist/index.js",
    "lockage-publish": "dist/launcher/publish-cli.js"
  },
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql && chmod +x dist/index.js dist/launcher/publish-cli.js",
    "prepublishOnly": "rm -rf dist && npm run build",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "node --test --import tsx test/*.test.ts",
    "test:unit": "node --test --import tsx \"test/!(e2e).test.ts\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --test --import tsx test/e2e.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "sync:plugins": "tsx scripts/sync-plugins.ts",
    "sync:versions": "tsx scripts/sync-versions.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "minimatch": "^10.0.0",
    "ulid": "^2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
