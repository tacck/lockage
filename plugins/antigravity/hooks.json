{
  "lockage": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "npx -y lockage@0.9.6 hook session --client antigravity --agents-md ./AGENTS.md",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y lockage@0.9.6 hook guard --client antigravity --event pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y lockage@0.9.6 hook guard --client antigravity --event post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}